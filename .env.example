# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=                    # Neon Postgres pooled connection string (main branch)
DATABASE_URL_DEVELOP=            # Neon Postgres pooled connection string (develop branch)

# ── Monad RPC ────────────────────────────────────────────────────────────────
MONAD_MAINNET_RPC_URL=           # dRPC / Ankr Premium / QuickNode (NOT a validator node)
MONAD_TESTNET_RPC_URL=           # Public testnet RPC (e.g. https://testnet-rpc.monad.xyz)

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=                       # Upstash Redis connection string

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=               # Anthropic production key, Tier 2+, server-side ONLY

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=                 # openssl rand -hex 32
GITHUB_CLIENT_ID=                # GitHub OAuth app, admin login only
GITHUB_CLIENT_SECRET=

# ── Telemetry ingest ──────────────────────────────────────────────────────────
TELEMETRY_INGEST_HMAC_SECRET=    # openssl rand -hex 32

# ── Vault daemon (testnet only) ───────────────────────────────────────────────
VAULT_OPERATOR_PRIVATE_KEY=      # Fresh testnet-only key, never a validator key

# ── Enrichment ────────────────────────────────────────────────────────────────
IPINFO_TOKEN=                    # ipinfo.io token (free tier covers <50K req/month)

# ── Observability ─────────────────────────────────────────────────────────────
BETTER_STACK_SOURCE_TOKEN=
SENTRY_DSN=

# ── Public (safe for NEXT_PUBLIC_*) ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://purpleiris.live
